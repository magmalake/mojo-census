# orca's default project image (orca aws push), plus the CA certificates at
# the paths libcurl, OpenSSL and flare look in. Drop this file once
# objectstore-mojo reads SSL_CERT_FILE and the system bundle.
# The image `orca aws push` builds for a project that added orca with
# `pixi shelf add orca-mojo`: its own `orca` (bin/scheduler.mojo, the two
# lines calling orca.command), its apps (every other bin/*.mojo, at
# /opt/orca/bin/<name>, which `orca aws app` runs) and its pipelines (every
# pipelines/*.mojo, at /opt/orca/pipelines/<name>), with `src/` on the
# import path if the project has one. A project with a Dockerfile.orca of
# its own builds that instead.
#
# They are two binaries in /opt/orca/bin, multicall-apps (orca, console)
# and multicall-pipelines (the rest), each running the program its name
# says, and each program's path is a link to one (scripts/build.sh): the
# code they share (orca, iceberg, parquet, flare...) is compiled once and is
# in the image once. Any change rebuilds all of one.
#
# ORCA_SOURCE and ORCA_COMMIT say what the pipelines were built from, which
# each run records and orca ui links.
#
# Everything is built with line tables (-g1) and the image has
# llvm-symbolizer, so a crash's stack dump in a run's driver.log names each
# frame's function, file and line. The line tables, compressed, make a
# binary about half as big again (gharchive: 4.2 MB, 6.5 MB with them,
# 25 MB uncompressed) and leave its speed as it was.
#
# MOJO_TARGET_CPU: mojo build targets the build host's CPU by default. CI
# builds on GitHub's arm64 runners (Neoverse N2, Armv9 with SVE2), and Hetzner's
# CAX servers are Ampere Altra (Neoverse N1, Armv8.2), where those binaries die
# with SIGILL (exit 132). Neoverse N1 code also runs on N2, V1/V2 and Graviton.
#
# The stages are ordered for the layer cache (CI keeps it between runs): `env`
# is the pixi environment and depends only on pixi.toml and pixi.lock, and
# both `build` (the project's source) and `git` (via `curl`) start from it, so
# a commit that changes only source reuses `pixi install` and git as they were.
# The build arguments are declared in the stages that use them, after `env`:
# a RUN sees every ARG declared before it, so a new ORCA_COMMIT on each commit
# would otherwise rerun `pixi install` too.
FROM ghcr.io/prefix-dev/pixi:0.78.0 AS env
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/project
COPY pixi.toml pixi.lock ./
RUN pixi install --locked

# MOJO_BUILD_JOBS: 1 builds the two multi-call binaries one after the other;
# otherwise scripts/build.sh builds them at once (see there).
FROM env AS build
ARG ORCA_SOURCE=""
ARG ORCA_COMMIT=""
ARG MOJO_TARGET_CPU=neoverse-n1
ARG MOJO_BUILD_JOBS=""
COPY . .
# ORCA_SOURCE and ORCA_COMMIT reach every program now, which only a
# pipeline's describe reads.
RUN mkdir -p /out/bin /out/pipelines \
    && pixi run sh -c 'sh scripts/build.sh /out/bin /out/pipelines -g1 --target-cpu "$MOJO_TARGET_CPU" \
            -D ORCA_SOURCE='"${ORCA_SOURCE}"' -D ORCA_COMMIT='"${ORCA_COMMIT}"' || exit 1; \
        echo "mojo build: peak memory $(awk "{print int(\$1 / 1048576)}" /sys/fs/cgroup/memory.peak 2> /dev/null) MB"; \
        if ls /out/pipelines/* > /dev/null 2>&1; then /out/bin/orca locate /out/pipelines/* --root .; fi'
# The line tables compressed, which llvm-symbolizer reads as they are: the
# binaries, not their links, which objcopy would replace with copies.
RUN for b in /out/bin/multicall-*; do objcopy --compress-debug-sections=zlib "$b" || exit 1; done
# Only the pixi environment's libraries the binaries link or dlopen: libpq
# (postgres), flare's shims (orca ui, apps), and every tin's shim, such as
# objectstore's and the codecs' (zstd, for Iceberg writes); and
# llvm-symbolizer, which Mojo's runtime runs to name a crash's frames, with
# what it links. Stripped of their symbol tables (libstdc++: 23.6 MB, 2.7
# stripped). Not conda's libpsl, which brings ICU (36 MB) and which libcurl
# alone links: the image has Debian's libpsl5. libpq once, with its two
# names as links. OpenSSL stays conda's: libcurl and libpq need 3.2.
RUN env=/src/project/.pixi/envs/default && mkdir -p /out/lib /out/libexec \
    && cp -L $env/bin/llvm-symbolizer /out/libexec/ \
    && loaded=$(ls $env/lib/libflare_*.so $env/lib/lib*mojo*.so 2>/dev/null) \
    && ldd /out/bin/* /out/pipelines/* /out/libexec/* $loaded $env/lib/libpq.so.5 2> /dev/null \
        | awk -v e="$env" '$3 ~ "^"e {print $3}' | grep -v -e '/libicu' -e '/libpsl' -e '/libpq\.' \
        | sort -u | xargs -r cp -L -t /out/lib \
    && cp -L -t /out/lib $loaded \
    && pq=$(basename $(readlink -f $env/lib/libpq.so.5)) && cp -L $env/lib/$pq /out/lib/ \
    && ln -s $pq /out/lib/libpq.so.5 && ln -s libpq.so.5 /out/lib/libpq.so \
    && for f in /out/lib/*; do [ -L "$f" ] || strip --strip-unneeded "$f" || exit 1; done

# git, for mojo_history and mojo_versions: only the `git` binary (every
# builtin they run) and git-remote-https, without Perl, Tcl/Tk, gettext,
# Python or expat (Debian's git package and what it pulls in: 90 MB; this,
# 5 MB). Built on the image's Debian against the pixi environment's libcurl,
# which /opt/orca/lib ships anyway (objectstore links it). `curl` gathers
# libcurl, the pixi libraries it links (not libpsl or ICU, as above) and its
# headers from `env`, not from `build`, so git is built again only when the
# pixi environment changes.
FROM env AS curl
RUN env=/src/project/.pixi/envs/default && mkdir -p /deps/lib /deps/include \
    && cp -L $env/lib/libcurl.so.4 /deps/lib/ \
    && ldd $env/lib/libcurl.so.4 | awk -v e="$env" '$3 ~ "^"e {print $3}' \
        | grep -v -e '/libicu' -e '/libpsl' | sort -u | xargs -r cp -L -t /deps/lib \
    && cp -r $env/include/curl /deps/include/

FROM debian:bookworm-slim AS git
ARG GIT_VERSION=2.51.2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gcc make libc6-dev \
      zlib1g-dev libpsl5 xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=curl /deps /deps
RUN curl -fsSL https://mirrors.edge.kernel.org/pub/software/scm/git/git-$GIT_VERSION.tar.xz | tar xJ -C /usr/src \
    && cd /usr/src/git-$GIT_VERSION && ln -s libcurl.so.4 /deps/lib/libcurl.so \
    && make -j"$(nproc)" prefix=/opt/orca gitexecdir=/opt/orca/libexec/git \
        template_dir=/opt/orca/libexec/git/templates \
        NO_PERL=1 NO_TCLTK=1 NO_GETTEXT=1 NO_PYTHON=1 NO_EXPAT=1 NO_OPENSSL=1 NO_INSTALL_HARDLINKS=1 \
        CURL_CFLAGS=-I/deps/include CURL_LDFLAGS='-L/deps/lib -lcurl -Wl,-rpath-link,/deps/lib' \
        git git-remote-http \
    && mkdir -p /opt/orca/bin /opt/orca/libexec/git/templates \
    && install -s git /opt/orca/libexec/git/git \
    && install -s git-remote-http /opt/orca/libexec/git/git-remote-https \
    && ln -s ../libexec/git/git /opt/orca/bin/git

FROM debian:bookworm-slim
# libpsl5 for libcurl (see above).
RUN apt-get update && apt-get install -y --no-install-recommends tzdata ca-certificates libpsl5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/lib /opt/orca/lib
COPY --from=build /out/bin /opt/orca/bin
COPY --from=build /out/pipelines /opt/orca/pipelines
COPY --from=build /out/libexec /opt/orca/libexec
COPY --from=git /opt/orca /opt/orca
# libcurl (objectstore) and OpenSSL (flare) look for CA certificates under
# the build environment's prefix, compiled in when conda relocated them, so
# keep that directory at the same path.
COPY --from=build /src/project/.pixi/envs/default/ssl /src/project/.pixi/envs/default/ssl
# gharchive's fetch hands flare $CONDA_PREFIX/ssl/cacert.pem, and
# CONDA_PREFIX is /opt/orca here.
COPY --from=build /src/project/.pixi/envs/default/ssl /opt/orca/ssl
# The census's settings, and what `orca register` (no arguments) reads: every
# pipeline in orca.toml, from ORCA_PIPELINES_DIR, with the commit and source
# these were built from. orca.dev.toml is the dev stack's (no fills, no
# worker pool), which it reads with ORCA_CONFIG=/opt/orca/orca.dev.toml.
COPY --from=build /src/project/orca.toml /src/project/orca.dev.toml /opt/orca/
ARG ORCA_SOURCE=""
ARG ORCA_COMMIT=""
ENV ORCA_CONFIG=/opt/orca/orca.toml ORCA_PIPELINES_DIR=/opt/orca/pipelines \
    ORCA_SOURCE=${ORCA_SOURCE} ORCA_COMMIT=${ORCA_COMMIT}
ENV CONDA_PREFIX=/opt/orca LD_LIBRARY_PATH=/opt/orca/lib PATH=/opt/orca/bin:/opt/orca/pipelines:/usr/bin:/bin \
    LLVM_SYMBOLIZER_PATH=/opt/orca/libexec/llvm-symbolizer GIT_EXEC_PATH=/opt/orca/libexec/git
ENTRYPOINT ["/opt/orca/bin/orca"]
